# Copie para .env.local (dev) ou configure na Vercel (Production). NUNCA commite valores reais.

# --- Obrigatórias ---------------------------------------------------------
# URL do projeto Supabase (Settings > API)
SUPABASE_URL=
# Service role key do Supabase: SOMENTE servidor, nunca NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=
# Bearer da rota /api/cron/sync (>= 32 caracteres aleatórios). Vercel Cron usa automaticamente.
CRON_SECRET=
# Webhook do canal do Discord onde os itens novos são postados
DISCORD_WEBHOOK_URL=

# --- Opcionais ------------------------------------------------------------
# ID de cargo mencionado em itens "Action Required" / "Breaking API Change"
DISCORD_ALERT_ROLE_ID=
# Chave da Anthropic: liga o resumo em pt-BR (sem ela, posta sem resumo)
ANTHROPIC_API_KEY=
# Modelo do resumo (padrão: claude-haiku-5-5)
ANTHROPIC_MODEL=claude-haiku-5-5
# URL do feed RSS (padrão: https://shopify.dev/changelog/feed.xml)
FEED_URL=https://shopify.dev/changelog/feed.xml
# Máximo de itens postados por execução do sync (padrão: 5)
MAX_POSTS_PER_RUN=5
# 1 = apenas loga o payload do Discord, não posta e não marca como sent
DISCORD_DRY_RUN=0
# 0 = desliga os avisos de atividade (acesso, início local, deploy)
ACTIVITY_NOTICES=
# URL pública do site, usada em metadata/OG (ex.: https://<app>.vercel.app)
SITE_URL=
